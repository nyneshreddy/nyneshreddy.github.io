# next-contentlayer 0.3.4 declares a Next 12/13 peer dependency, but the site
# runs Next 14. Keep installs reproducible in CI and local builds until the
# Contentlayer integration is replaced or updated.
legacy-peer-deps=true

# pnpm configuration for Contentlayer, IDE TypeScript, and Next.js 14 compatibility
node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
